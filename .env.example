# Ollama Cloud (the agent's model) — https://ollama.com/settings/keys
OLLAMA_API_KEY=

# Slack incoming webhook the daily badge report is posted to
# Create one: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# Garmin Connect credentials (accounts with MFA are not supported — see README)
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Vercel Blob (Garmin tokens + seen-badge state) — auto-injected in prod once a
# Blob store is connected to the project; `vercel env pull .env.local` for local dev
BLOB_READ_WRITE_TOKEN=

# Shared secret for manually triggering the deployed agent over HTTP Basic
ROUTE_AUTH_BASIC_USER=test
ROUTE_AUTH_BASIC_PASSWORD=

# Optional: set to 1 to skip the real Slack post (tool returns dryRun instead)
# BADGE_DRY_RUN=1

# VERCEL_OIDC_TOKEN is provided automatically by Vercel — no need to set locally
